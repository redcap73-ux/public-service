{
  "name": "public-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "bundle:acroform": "esbuild lib/acroform-fill.ts --bundle --format=esm --platform=browser --outfile=viewpub/acroform-fill.bundle.mjs",
    "bundle:signed-pdf": "esbuild lib/signed-pdf.ts --bundle --format=esm --platform=browser --outfile=viewpub/signed-pdf.bundle.mjs",
    "bundle:signpage": "npm run bundle:acroform && npm run bundle:signed-pdf",
    "build": "npm run bundle:signpage && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@napi-rs/canvas": "^1.0.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@portone/browser-sdk": "^0.1.9",
    "next": "15.1.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "server-only": "^0.0.1",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-signature-canvas": "^1.0.7",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "typescript": "^5"
  }
}
